{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:protocol:1.0-draft.1:error",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "kind",
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "yamai": {
          "const": "1.0-draft.1"
        },
        "kind": {
          "const": "error"
        },
        "session_id": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
        },
        "game_id": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
        },
        "seq": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/positiveInteger"
        },
        "code": {
          "enum": [
            "unsupported_version",
            "unsupported_profile",
            "unsupported_view",
            "profile_mismatch",
            "unsupported_capability",
            "unsupported_rules",
            "unsupported_limit",
            "unsupported_frame",
            "invalid_frame",
            "invalid_json",
            "invalid_message",
            "sequence_gap",
            "sequence_conflict",
            "invalid_action",
            "request_conflict",
            "resume_unavailable",
            "resource_limit",
            "internal_error"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "recoverable",
            "fatal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "caused_by_seq": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/positiveInteger"
        },
        "request_id": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
        },
        "expected_seq": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/positiveInteger"
        },
        "received_seq": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/positiveInteger"
        },
        "action_id": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
        },
        "original_status": {
          "type": "string",
          "enum": [
            "accepted",
            "passed",
            "superseded",
            "defaulted",
            "stale"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "unsupported_version",
                  "unsupported_profile",
                  "unsupported_view",
                  "profile_mismatch",
                  "unsupported_capability",
                  "unsupported_rules",
                  "unsupported_limit",
                  "unsupported_frame",
                  "invalid_frame",
                  "invalid_json",
                  "sequence_conflict",
                  "resume_unavailable",
                  "resource_limit",
                  "internal_error"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "fatal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "sequence_gap",
                  "invalid_action",
                  "request_conflict"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "recoverable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "sequence_gap"
              }
            }
          },
          "then": {
            "required": [
              "expected_seq",
              "received_seq"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "expected_seq"
                  ]
                },
                {
                  "required": [
                    "received_seq"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "request_conflict"
              }
            }
          },
          "then": {
            "required": [
              "request_id",
              "action_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "original_status"
              ]
            }
          }
        }
      ]
    },
    "preNegotiation": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "yamai"
                ]
              },
              {
                "required": [
                  "session_id"
                ]
              },
              {
                "required": [
                  "game_id"
                ]
              },
              {
                "required": [
                  "seq"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "code": {
              "enum": [
                "unsupported_version",
                "unsupported_profile",
                "unsupported_view",
                "profile_mismatch",
                "unsupported_capability",
                "unsupported_rules",
                "unsupported_limit",
                "unsupported_frame",
                "invalid_frame",
                "invalid_json",
                "invalid_message",
                "resume_unavailable",
                "resource_limit",
                "internal_error"
              ]
            },
            "severity": {
              "const": "fatal"
            }
          }
        }
      ]
    },
    "hostApplication": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "yamai",
            "session_id",
            "game_id",
            "seq"
          ]
        },
        {
          "properties": {
            "code": {
              "enum": [
                "unsupported_frame",
                "invalid_frame",
                "invalid_json",
                "invalid_message",
                "invalid_action",
                "request_conflict",
                "resume_unavailable",
                "resource_limit",
                "internal_error"
              ]
            }
          }
        }
      ]
    },
    "playerApplication": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "required": [
            "yamai",
            "session_id",
            "game_id"
          ]
        },
        {
          "not": {
            "required": [
              "seq"
            ]
          }
        },
        {
          "properties": {
            "code": {
              "enum": [
                "unsupported_frame",
                "invalid_frame",
                "invalid_json",
                "invalid_message",
                "sequence_gap",
                "sequence_conflict",
                "unsupported_rules",
                "resource_limit",
                "internal_error"
              ]
            }
          },
          "if": {
            "properties": {
              "code": {
                "const": "invalid_message"
              }
            }
          },
          "then": {
            "properties": {
              "severity": {
                "const": "fatal"
              }
            }
          }
        }
      ]
    },
    "hostMessage": {
      "anyOf": [
        {
          "$ref": "#/$defs/preNegotiation"
        },
        {
          "$ref": "#/$defs/hostApplication"
        }
      ]
    },
    "playerMessage": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/preNegotiation"
            },
            {
              "not": {
                "properties": {
                  "code": {
                    "const": "resume_unavailable"
                  }
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/playerApplication"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/preNegotiation"
    },
    {
      "$ref": "#/$defs/hostApplication"
    },
    {
      "$ref": "#/$defs/playerApplication"
    }
  ]
}
