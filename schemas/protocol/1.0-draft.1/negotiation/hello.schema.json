{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:protocol:1.0-draft.1:hello",
  "type": "object",
  "required": [
    "kind",
    "protocol",
    "versions",
    "profiles",
    "capabilities",
    "receive_limits"
  ],
  "properties": {
    "kind": {
      "const": "hello"
    },
    "protocol": {
      "const": "yamai"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/version"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/profileAdvertisement"
      }
    },
    "capabilities": {
      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/capabilities"
    },
    "receive_limits": {
      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/receiveLimits"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
  }
}
