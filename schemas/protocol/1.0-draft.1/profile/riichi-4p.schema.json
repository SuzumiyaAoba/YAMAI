{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:protocol:1.0-draft.1:riichi-4p",
  "title": "YAMAI riichi-4p profile descriptor",
  "type": "object",
  "required": [
    "name",
    "revision",
    "hash",
    "rules"
  ],
  "properties": {
    "name": {
      "const": "riichi-4p"
    },
    "revision": {
      "const": "1.0-draft.1"
    },
    "hash": {
      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/profileHash"
    },
    "rules": {
      "$ref": "urn:yamai:schema:riichi-4p:1.0-draft.1:riichi-4p-rules"
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
  }
}
