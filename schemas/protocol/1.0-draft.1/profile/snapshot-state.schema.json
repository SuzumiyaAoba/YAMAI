            "consumed": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
