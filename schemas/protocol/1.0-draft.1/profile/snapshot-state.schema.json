      "additionalProperties": false,
      "patternProperties": {
        "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "action_id",
        "source",
        "elapsed_ms",
        "time_bank_ms"
