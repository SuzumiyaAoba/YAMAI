  "type": "object",
  "required": [
    "mode",
    "seat",
    "view",
    "players",
    "scores",
    "kyoku",
    "game_phase",
    "kyotaku",
    "next_kyoku",
    "final_rankings"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "play",
        "spectate",
        "replay"
      ]
    },
    "seat": {
      "anyOf": [
        {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
        },
        {
          "type": "null"
        }
      ]
    },
    "view": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "seat",
            "public",
            "full"
          ]
        },
        {
          "type": "object",
          "required": [
            "seat"
          ],
          "properties": {
            "seat": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
          }
        }
      ]
    },
    "players": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "seat",
          "name"
        ],
        "properties": {
          "seat": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": false,
        "patternProperties": {
          "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
        }
      }
    },
    "scores": {
      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/scoreArray"
    },
    "kyoku": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "bakaze",
            "kyoku",
            "honba",
            "kyotaku",
            "oya",
            "extension_round",
            "hands",
            "rivers",
            "melds",
            "dora_markers",
            "wall_remaining",
            "turn",
            "reach_status",
            "first_turn_eligible",
            "kan_counts",
            "rinshan",
            "haitei",
            "pending_kan",
            "pao",
            "pending_dora"
          ],
          "properties": {
            "bakaze": {
              "type": "string",
              "enum": [
                "E",
                "S",
                "W",
                "N"
              ]
            },
            "kyoku": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "honba": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/nonNegativeInteger"
            },
            "kyotaku": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/nonNegativeInteger"
            },
            "oya": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
            },
            "extension_round": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "hands": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/hands"
            },
            "rivers": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pai",
                    "tsumogiri",
                    "reach",
                    "called_by"
                  ],
                  "properties": {
                    "pai": {
                      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
                    },
                    "tsumogiri": {
                      "type": "boolean"
                    },
                    "reach": {
                      "type": "boolean"
                    },
                    "called_by": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "patternProperties": {
                    "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
                  }
                }
              }
            },
            "melds": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/meld"
                }
              }
            },
            "dora_markers": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
              },
              "minItems": 1
            },
            "wall_remaining": {
              "type": "integer",
              "minimum": 0,
              "maximum": 70
            },
            "turn": {
              "type": "object",
              "required": [
                "actor",
                "phase",
                "last_event_seq",
                "last_event"
              ],
              "properties": {
                "actor": {
                  "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "awaiting_draw",
                    "awaiting_action",
                    "awaiting_responses",
                    "resolving"
                  ]
                },
                "last_event_seq": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/positiveInteger"
                    }
                  ]
                },
                "last_event": {
                  "$ref": "#/$defs/lastEvent"
                }
              },
              "additionalProperties": false,
              "patternProperties": {
                "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
              }
            },
            "reach_status": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "state",
                  "double",
                  "ippatsu"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "none",
                      "declared",
                      "accepted"
                    ]
                  },
                  "double": {
                    "type": "boolean"
                  },
                  "ippatsu": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
                }
              }
            },
            "first_turn_eligible": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "boolean"
              }
            },
            "kan_counts": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            },
            "rinshan": {
              "type": "boolean"
            },
            "haitei": {
              "type": "boolean"
            },
            "pending_kan": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/pendingKan"
                }
              ]
            },
            "pao": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/pao"
              }
            },
            "self_state": {
              "$ref": "#/$defs/selfState"
            },
            "pending_dora": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "kan_type",
                    "timing"
                  ],
                  "properties": {
                    "kan_type": {
                      "enum": [
                        "ankan",
                        "daiminkan",
                        "kakan"
                      ]
                    },
                    "timing": {
                      "const": "after_rinshan_discard"
                    }
                  },
                  "additionalProperties": false,
                  "patternProperties": {
                    "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
          }
        }
      ]
    },
    "pending_requests": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "seat",
          "caused_by_seq",
          "timeout_ms",
          "time_bank_ms",
          "legal_actions",
          "default_action_id",
          "remaining_ms",
          "selection"
        ],
        "properties": {
          "request_id": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
          },
          "decision_group_id": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
          },
          "decision_group_members": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "request_id",
                "seat"
              ],
              "properties": {
                "request_id": {
                  "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
                },
                "seat": {
                  "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
                }
              },
              "additionalProperties": false,
              "patternProperties": {
                "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
              }
            }
          },
          "decision_group_deadline_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200000
          },
          "decision_group_close": {
            "const": "all_selected_or_deadline"
          },
          "seat": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
          },
          "caused_by_seq": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/positiveInteger"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "time_bank_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "legal_actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:action#/$defs/actionCandidate"
            }
          },
          "default_action_id": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
          },
          "remaining_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1800000
          },
          "selection": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/selection"
              }
            ]
          },
          "decision_group_remaining_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1200000
          }
