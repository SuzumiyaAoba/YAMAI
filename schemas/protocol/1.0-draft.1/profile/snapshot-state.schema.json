    "lastEvent": {
      "$ref": "urn:yamai:schema:protocol:1.0-draft.1:event#/properties/event"
    },
    "selfState": {
      "type": "object",
      "required": [
        "temporary_furiten",
        "riichi_furiten",
        "kuikae_forbidden",
        "time_bank_ms"
      ],
      "properties": {
        "temporary_furiten": {
          "type": "boolean"
        },
        "riichi_furiten": {
          "type": "boolean"
        },
        "kuikae_forbidden": {
          "type": "array",
          "items": {
            "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
          }
        },
        "time_bank_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
      }
    },
    "pao": {
      "type": "object",
      "required": [
        "actor",
        "yaku_id",
        "liable_seat"
      ],
      "properties": {
        "actor": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
        },
        "yaku_id": {
          "enum": [
            "daisangen",
            "daisuushii"
