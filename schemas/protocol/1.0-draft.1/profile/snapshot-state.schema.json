            "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
          }
        }
      ]
    },
    "pendingKan": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "actor",
            "consumed"
          ],
          "properties": {
            "type": {
              "const": "ankan_declared"
