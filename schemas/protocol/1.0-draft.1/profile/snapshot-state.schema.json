            "actor": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
            },
            "pai": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
            },
            "consumed": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
              }
