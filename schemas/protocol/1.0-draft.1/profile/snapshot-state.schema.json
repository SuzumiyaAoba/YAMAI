      "properties": {
        "action_id": {
          "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/id"
        },
        "source": {
          "enum": [
            "user",
            "default"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800000
        },
        "time_bank_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
      }
    }
