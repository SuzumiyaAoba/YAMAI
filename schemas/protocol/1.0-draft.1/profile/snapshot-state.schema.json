            "actor": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
            },
            "consumed": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "actor",
            "pai",
            "consumed"
          ],
          "properties": {
            "type": {
              "const": "kakan_declared"
            },
            "actor": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/seat"
            },
            "pai": {
              "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
            },
            "consumed": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "$ref": "urn:yamai:schema:protocol:1.0-draft.1:common#/$defs/tile"
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}(?![\\s\\S]))[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*(?![\\s\\S])": {}
          }
        }
      ]
