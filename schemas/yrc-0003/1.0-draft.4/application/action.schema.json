{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0003:1.0-draft.4:action",
  "$defs": {
    "seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/seat"},
    "tile": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/tile"},
    "dahai": {
      "type": "object", "required": ["type", "actor", "pai", "tsumogiri"],
      "properties": {"type": {"const": "dahai"}, "actor": {"$ref": "#/$defs/seat"}, "pai": {"$ref": "#/$defs/tile"}, "tsumogiri": {"type": "boolean"}},
      "additionalProperties": true
    },
    "meld": {
      "type": "object", "required": ["type", "actor", "target", "pai", "consumed"],
      "properties": {
        "type": {"type": "string", "enum": ["chi", "pon", "daiminkan"]},
        "actor": {"$ref": "#/$defs/seat"}, "target": {"$ref": "#/$defs/seat"}, "pai": {"$ref": "#/$defs/tile"},
        "consumed": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/tile"}},
        "dahai": {"$ref": "#/$defs/dahai"}
      },
      "additionalProperties": true
    },
    "actionObject": {
      "oneOf": [
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "none"}, "actor": {"$ref": "#/$defs/seat"}}, "additionalProperties": true},
        {"$ref": "#/$defs/dahai"},
        {"type": "object", "required": ["type", "actor"], "properties": {"type": {"const": "hora"}, "actor": {"$ref": "#/$defs/seat"}}, "additionalProperties": true},
        {"type": "object", "required": ["type", "actor"], "properties": {"type": {"const": "ryukyoku"}, "actor": {"$ref": "#/$defs/seat"}}, "additionalProperties": true},
        {"$ref": "#/$defs/meld"},
        {"type": "object", "required": ["type", "actor", "consumed"], "properties": {"type": {"const": "ankan"}, "actor": {"$ref": "#/$defs/seat"}, "consumed": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/tile"}}}, "additionalProperties": true},
        {"type": "object", "required": ["type", "actor", "pai", "consumed"], "properties": {"type": {"const": "kakan"}, "actor": {"$ref": "#/$defs/seat"}, "pai": {"$ref": "#/$defs/tile"}, "consumed": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/tile"}}}, "additionalProperties": true},
        {"type": "object", "required": ["type", "actor", "dahai"], "properties": {"type": {"const": "reach"}, "actor": {"$ref": "#/$defs/seat"}, "dahai": {"$ref": "#/$defs/dahai"}}, "additionalProperties": true}
      ]
    },
    "actionCandidate": {
      "type": "object",
      "required": ["action_id", "action"],
      "properties": {
        "action_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"},
        "action": {"$ref": "#/$defs/actionObject"}
      },
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["yamai", "kind", "session_id", "game_id", "request_id", "action_id"],
  "properties": {
    "yamai": {"const": "1.0-draft.4"},
    "kind": {"const": "action"},
    "session_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"},
    "game_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"},
    "request_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"},
    "action_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"}
  },
  "additionalProperties": true
}
