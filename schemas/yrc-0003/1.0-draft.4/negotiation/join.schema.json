{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0003:1.0-draft.4:join",
  "type": "object",
  "required": ["kind", "version", "mode", "view", "profile", "profile_revision", "profile_hash", "client", "capabilities", "receive_limits"],
  "properties": {
    "kind": {"const": "join"},
    "version": {"const": "1.0-draft.4"},
    "mode": {"type": "string", "enum": ["play", "spectate", "replay"]},
    "view": {
      "anyOf": [
        {"type": "string", "enum": ["seat", "public", "full"]},
        {"type": "object", "required": ["seat"], "properties": {"seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/seat"}}, "additionalProperties": false}
      ]
    },
    "profile": {"const": "riichi-4p"},
    "profile_revision": {"const": "1.0-draft.2"},
    "profile_hash": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/profileHash"},
    "client": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/client"},
    "capabilities": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/capabilities"},
    "receive_limits": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/receiveLimits"},
    "room": {"type": "string", "minLength": 1, "maxLength": 128},
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "resume": {
      "type": "object",
      "required": ["token", "last_seq"],
      "properties": {
        "token": {"type": "string", "pattern": "^[A-Za-z0-9._~-]{22,256}$"},
        "last_seq": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/safeInteger"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
