{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0003:1.0-draft.4:snapshot-state",
  "type": "object",
  "required": ["mode", "seat", "players", "scores", "kyoku", "pending_requests"],
  "properties": {
    "mode": {"type": "string", "enum": ["play", "spectate", "replay"]},
    "seat": {"anyOf": [{"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/seat"}, {"type": "null"}]},
    "view": {"type": "string", "enum": ["seat", "public", "full"]},
    "players": {"type": "array", "minItems": 4, "maxItems": 4},
    "scores": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/scoreArray"},
    "kyoku": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["bakaze", "kyoku", "honba", "kyotaku", "oya", "extension_round", "hands", "rivers", "melds", "dora_markers", "wall_remaining", "turn", "reach_status", "first_turn_eligible", "kan_counts", "rinshan", "haitei", "pending_kan"],
          "properties": {
            "bakaze": {"type": "string", "enum": ["E", "S", "W", "N"]},
            "kyoku": {"type": "integer", "minimum": 1, "maximum": 4},
            "honba": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/nonNegativeInteger"},
            "kyotaku": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/nonNegativeInteger"},
            "oya": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/seat"},
            "extension_round": {"type": "integer", "minimum": 0, "maximum": 100},
            "hands": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/hands"},
            "rivers": {"type": "array", "minItems": 4, "maxItems": 4},
            "melds": {"type": "array", "minItems": 4, "maxItems": 4},
            "dora_markers": {"type": "array", "maxItems": 5, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/tile"}},
            "wall_remaining": {"type": "integer", "minimum": 0, "maximum": 136},
            "turn": {"type": "object", "required": ["actor", "phase", "last_event_seq", "last_event"], "properties": {"actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/seat"}, "phase": {"type": "string", "enum": ["awaiting_draw", "awaiting_action", "awaiting_responses", "resolving"]}, "last_event_seq": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/positiveInteger"}, "last_event": {"type": "object"}}, "additionalProperties": true},
            "reach_status": {"type": "array", "minItems": 4, "maxItems": 4},
            "first_turn_eligible": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "boolean"}},
            "kan_counts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 4}},
            "rinshan": {"type": "boolean"}, "haitei": {"type": "boolean"},
            "pending_kan": {"anyOf": [{"type": "null"}, {"type": "object"}]},
            "pao": {"type": "array"},
            "self_state": {"type": "object"}
          },
          "additionalProperties": true
        }
      ]
    },
    "pending_requests": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["request_id", "seat", "caused_by_seq", "timeout_ms", "time_bank_ms", "legal_actions", "default_action_id"],
        "properties": {
          "request_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"},
          "decision_group_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"},
          "decision_group_members": {"type": "array", "minItems": 2, "maxItems": 4},
          "decision_group_deadline_ms": {"type": "integer", "minimum": 0, "maximum": 1200000},
          "decision_group_close": {"const": "all_resolved_or_deadline"},
          "seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/seat"},
          "caused_by_seq": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/positiveInteger"},
          "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
          "time_bank_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
          "legal_actions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:action#/$defs/actionCandidate"}},
          "default_action_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.4:common#/$defs/id"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
