{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0003:1.0-draft.5:snapshot-state",
  "$defs": {
    "extension": {"patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}},
    "meld": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "actor", "target", "pai", "consumed"],
          "properties": {
            "type": {"enum": ["chi", "pon", "daiminkan"]},
            "actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
            "target": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
            "pai": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"},
            "consumed": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
        },
        {
          "type": "object",
          "required": ["type", "actor", "consumed"],
          "properties": {
            "type": {"enum": ["ankan_declared", "ankan"]},
            "actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
            "consumed": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tileOrHidden"}}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
        },
        {
          "type": "object",
          "required": ["type", "actor", "pai", "consumed"],
          "properties": {
            "type": {"enum": ["kakan_declared", "kakan"]},
            "actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
            "pai": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"},
            "consumed": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
        }
      ]
    },
    "pendingKan": {
      "oneOf": [
        {"type": "object", "required": ["type", "actor", "consumed"], "properties": {"type": {"const": "ankan_declared"}, "actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}, "consumed": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tileOrHidden"}}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}},
        {"type": "object", "required": ["type", "actor", "pai", "consumed"], "properties": {"type": {"const": "kakan_declared"}, "actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}, "pai": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}, "consumed": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}}
      ]
    },
    "lastEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["start_game", "start_kyoku", "tsumo", "dahai", "chi", "pon", "daiminkan", "ankan_declared", "ankan", "kakan_declared", "kakan", "dora", "reach", "reach_accepted", "pao", "end_kyoku", "end_game"]},
        "actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
        "target": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
        "pai": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tileOrHidden"},
        "consumed": {"type": "array", "maxItems": 4, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tileOrHidden"}},
        "tsumogiri": {"type": "boolean"},
        "dora_marker": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"},
        "deltas": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/scoreArray"},
        "scores": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/scoreArray"},
        "kyotaku": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/nonNegativeInteger"},
        "result": {"$ref": "urn:yamai:schema:yrc-0005:1.0-draft.3:scoring-result"},
        "next": {"type": "object"},
        "players": {"type": "array"},
        "rules": {"$ref": "urn:yamai:schema:yrc-0005:1.0-draft.3:riichi-4p-rules"},
        "yaku_id": {"type": "string"},
        "liable_seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}
      },
      "additionalProperties": false,
      "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
    },
    "selfState": {
      "type": "object",
      "required": ["temporary_furiten", "riichi_furiten", "kuikae_forbidden", "time_bank_ms"],
      "properties": {
        "temporary_furiten": {"type": "boolean"},
        "riichi_furiten": {"type": "boolean"},
        "kuikae_forbidden": {"type": "array", "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}},
        "time_bank_ms": {"type": "integer", "minimum": 0, "maximum": 600000}
      },
      "additionalProperties": false,
      "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
    }
  },
  "type": "object",
  "required": ["mode", "seat", "view", "players", "scores", "kyoku"],
  "properties": {
    "mode": {"type": "string", "enum": ["play", "spectate", "replay"]},
    "seat": {"anyOf": [{"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}, {"type": "null"}]},
    "view": {
      "anyOf": [
        {"type": "string", "enum": ["seat", "public", "full"]},
        {"type": "object", "required": ["seat"], "properties": {"seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}}
      ]
    },
    "players": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["seat", "name"],
        "properties": {"seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}, "name": {"type": "string", "minLength": 1, "maxLength": 128}},
        "additionalProperties": false,
        "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
      }
    },
    "scores": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/scoreArray"},
    "kyoku": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["bakaze", "kyoku", "honba", "kyotaku", "oya", "extension_round", "hands", "rivers", "melds", "dora_markers", "wall_remaining", "turn", "reach_status", "first_turn_eligible", "kan_counts", "rinshan", "haitei", "pending_kan"],
          "properties": {
            "bakaze": {"type": "string", "enum": ["E", "S", "W", "N"]},
            "kyoku": {"type": "integer", "minimum": 1, "maximum": 4},
            "honba": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/nonNegativeInteger"},
            "kyotaku": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/nonNegativeInteger"},
            "oya": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
            "extension_round": {"type": "integer", "minimum": 0, "maximum": 100},
            "hands": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/hands"},
            "rivers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "items": {"type": "object", "required": ["pai", "tsumogiri", "reach"], "properties": {"pai": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}, "tsumogiri": {"type": "boolean"}, "reach": {"type": "boolean"}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}}}},
            "melds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "items": {"$ref": "#/$defs/meld"}}},
            "dora_markers": {"type": "array", "maxItems": 5, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/tile"}},
            "wall_remaining": {"type": "integer", "minimum": 0, "maximum": 136},
            "turn": {"type": "object", "required": ["actor", "phase", "last_event_seq", "last_event"], "properties": {"actor": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}, "phase": {"type": "string", "enum": ["awaiting_draw", "awaiting_action", "awaiting_responses", "resolving"]}, "last_event_seq": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/positiveInteger"}, "last_event": {"$ref": "#/$defs/lastEvent"}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}},
            "reach_status": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["state", "double", "ippatsu"], "properties": {"state": {"type": "string", "enum": ["none", "declared", "accepted"]}, "double": {"type": "boolean"}, "ippatsu": {"type": "boolean"}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}}},
            "first_turn_eligible": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "boolean"}},
            "kan_counts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 4}},
            "rinshan": {"type": "boolean"}, "haitei": {"type": "boolean"},
            "pending_kan": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/pendingKan"}]},
            "pao": {"type": "array"},
            "self_state": {"$ref": "#/$defs/selfState"}
          },
          "additionalProperties": false,
          "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
        }
      ]
    },
    "pending_requests": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["request_id", "seat", "caused_by_seq", "timeout_ms", "time_bank_ms", "legal_actions", "default_action_id"],
        "properties": {
          "request_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/id"},
          "decision_group_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/id"},
          "decision_group_members": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "object", "required": ["request_id", "seat"], "properties": {"request_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/id"}, "seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}}},
          "decision_group_deadline_ms": {"type": "integer", "minimum": 0, "maximum": 1200000},
          "decision_group_close": {"const": "all_resolved_or_deadline"},
          "seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"},
          "caused_by_seq": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/positiveInteger"},
          "timeout_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
          "time_bank_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
          "legal_actions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:action#/$defs/actionCandidate"}},
          "default_action_id": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/id"}
        },
        "additionalProperties": false,
        "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "play"}}},
      "then": {
        "required": ["pending_requests"],
        "properties": {"seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}, "view": {"const": "seat"}}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "spectate"}}},
      "then": {
        "properties": {"seat": {"type": "null"}, "view": {"const": "public"}},
        "not": {"required": ["pending_requests"]}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "replay"}}},
      "then": {
        "properties": {
          "seat": {"type": "null"},
          "view": {"anyOf": [{"type": "string", "enum": ["public", "full"]}, {"type": "object", "required": ["seat"], "properties": {"seat": {"$ref": "urn:yamai:schema:yrc-0003:1.0-draft.5:common#/$defs/seat"}}, "additionalProperties": false, "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}}]}
        },
        "not": {"required": ["pending_requests"]}
      }
    },
    {
      "if": {"properties": {"mode": {"const": "play"}, "kyoku": {"type": "object"}}},
      "then": {"properties": {"kyoku": {"required": ["self_state"]}}}
    },
    {
      "if": {"properties": {"mode": {"enum": ["spectate", "replay"]}, "kyoku": {"type": "object"}}},
      "then": {"properties": {"kyoku": {"not": {"required": ["self_state"]}}}}
    }
  ],
  "additionalProperties": false,
  "patternProperties": {"^x_[A-Za-z0-9][A-Za-z0-9_]{0,63}$": {}}
}
