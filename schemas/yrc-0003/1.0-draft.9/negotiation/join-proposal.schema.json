{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0003:1.0-draft.9:join-proposal",
  "type": "object",
  "required": [
    "kind",
    "version",
    "mode",
    "view",
    "profile",
    "profile_revision",
    "profile_hash",
    "client",
    "capabilities",
    "receive_limits"
  ],
  "properties": {
    "kind": {
      "const": "join"
    },
    "version": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/version"
    },
    "mode": {
      "type": "string",
      "enum": [
        "play",
        "spectate",
        "replay"
      ]
    },
    "view": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "seat",
            "public",
            "full"
          ]
        },
        {
          "type": "object",
          "required": [
            "seat"
          ],
          "properties": {
            "seat": {
              "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/seat"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}$)[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*$": {}
          }
        }
      ]
    },
    "profile": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/profileName"
    },
    "profile_revision": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/version"
    },
    "profile_hash": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/profileHash"
    },
    "client": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/client"
    },
    "capabilities": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/capabilities"
    },
    "receive_limits": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/receiveLimits"
    },
    "room": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "game"
            },
            "id": {
              "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/id"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}$)[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*$": {}
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "recording"
            },
            "id": {
              "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/id"
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x_(?=[A-Za-z0-9_]{3,62}$)[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*$": {}
          }
        }
      ]
    },
    "resume": {
      "type": "object",
      "required": [
        "token",
        "last_seq"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{22,256}$"
        },
        "last_seq": {
          "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/nonNegativeInteger"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x_(?=[A-Za-z0-9_]{3,62}$)[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*$": {}
      }
    },
    "seat": {
      "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/seat"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "play"
          }
        }
      },
      "then": {
        "properties": {
          "view": {
            "const": "seat"
          }
        },
        "not": {
          "required": [
            "target"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "spectate"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "view": {
            "const": "public"
          },
          "target": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "game"
              }
            }
          }
        },
        "not": {
          "required": [
            "resume"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replay"
          }
        }
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "game",
                  "recording"
                ]
              }
            }
          },
          "view": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "public",
                  "full"
                ]
              },
              {
                "type": "object",
                "required": [
                  "seat"
                ],
                "properties": {
                  "seat": {
                    "$ref": "urn:yamai:schema:yrc-0003:1.0-draft.9:common#/$defs/seat"
                  }
                },
                "additionalProperties": false,
                "patternProperties": {
                  "^x_(?=[A-Za-z0-9_]{3,62}$)[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*$": {}
                }
              }
            ]
          }
        },
        "not": {
          "required": [
            "resume"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "resume"
            ]
          },
          {
            "properties": {
              "mode": {
                "enum": [
                  "spectate",
                  "replay"
                ]
              }
            }
          }
        ]
      },
      "then": {
        "not": {
          "required": [
            "room"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "mode": {
                "enum": [
                  "spectate",
                  "replay"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          {
            "required": [
              "resume"
            ]
          }
        ]
      },
      "then": {
        "not": {
          "required": [
            "seat"
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_(?=[A-Za-z0-9_]{3,62}$)[A-Za-z0-9]+_[A-Za-z0-9][A-Za-z0-9_]*$": {}
  },
  "title": "Pre-selection join syntax for deterministic negotiation errors"
}
