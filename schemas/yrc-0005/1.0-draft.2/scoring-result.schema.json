{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0005:1.0-draft.2:scoring-result",
  "title": "YAMAI riichi-4p result variants",
  "$defs": {
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "tile": {
      "type": "string",
      "enum": [
        "1m", "2m", "3m", "4m", "5m", "5mr", "6m", "7m", "8m", "9m",
        "1p", "2p", "3p", "4p", "5p", "5pr", "6p", "7p", "8p", "9p",
        "1s", "2s", "3s", "4s", "5s", "5sr", "6s", "7s", "8s", "9s",
        "E", "S", "W", "N", "P", "F", "C"
      ]
    },
    "safeInteger": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "scoreArray": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/safeInteger"}
    },
    "yaku": {
      "type": "object",
      "required": ["id", "value", "unit"],
      "properties": {
        "id": {"type": "string"},
        "value": {"type": "integer", "minimum": 1, "maximum": 4},
        "unit": {"type": "string", "enum": ["han", "yakuman"]}
      },
      "additionalProperties": true
    },
    "bonus": {
      "type": "object",
      "required": ["id", "han"],
      "properties": {
        "id": {"type": "string"},
        "han": {"type": "integer", "minimum": 1, "maximum": 99}
      },
      "additionalProperties": true
    },
    "paoEntry": {
      "type": "object",
      "required": ["yaku_id", "liable_seat"],
      "properties": {
        "yaku_id": {"type": "string"},
        "liable_seat": {"$ref": "#/$defs/seat"}
      },
      "additionalProperties": false
    },
    "win": {
      "type": "object",
      "required": [
        "actor", "target", "pai", "fu", "han", "yakus", "bonuses", "hand_points",
        "deltas", "ura_dora_markers", "pao"
      ],
      "properties": {
        "actor": {"$ref": "#/$defs/seat"},
        "target": {"$ref": "#/$defs/seat"},
        "pai": {"$ref": "#/$defs/tile"},
        "fu": {"type": "integer", "minimum": 0, "maximum": 2000},
        "han": {"type": "integer", "minimum": 0, "maximum": 99},
        "yakus": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/yaku"}
        },
        "bonuses": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/bonus"}
        },
        "hand_points": {"type": "integer", "minimum": 0, "maximum": 9007199254740900},
        "deltas": {"$ref": "#/$defs/scoreArray"},
        "ura_dora_markers": {
          "type": "array", "maxItems": 5,
          "items": {"$ref": "#/$defs/tile"}
        },
        "pao": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/paoEntry"}
        }
      },
      "additionalProperties": true
    },
    "hora": {
      "type": "object",
      "required": ["type", "wins"],
      "properties": {
        "type": {"const": "hora"},
        "wins": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/win"}}
      },
      "additionalProperties": true
    },
    "ryukyoku": {
      "type": "object",
      "required": ["type", "reason", "tenpai"],
      "properties": {
        "type": {"const": "ryukyoku"},
        "reason": {"type": "string"},
        "tenpai": {
          "anyOf": [
            {"type": "null"},
            {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "boolean"}}
          ]
        }
      },
      "additionalProperties": true
    },
    "payment": {
      "type": "object",
      "required": ["from", "to", "points"],
      "properties": {
        "from": {"$ref": "#/$defs/seat"},
        "to": {"$ref": "#/$defs/seat"},
        "points": {"type": "integer", "minimum": 0, "maximum": 9007199254740900}
      },
      "additionalProperties": false
    },
    "penalty": {
      "type": "object",
      "required": ["type", "offender", "reason", "penalty"],
      "properties": {
        "type": {"const": "penalty"},
        "offender": {"$ref": "#/$defs/seat"},
        "reason": {"type": "string"},
        "penalty": {
          "type": "object",
          "required": ["payments"],
          "properties": {
            "payments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/payment"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/hora"},
    {"$ref": "#/$defs/ryukyoku"},
    {"$ref": "#/$defs/penalty"}
  ]
}
