    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/summary_vector"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "negative_fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/negative_fixture"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
