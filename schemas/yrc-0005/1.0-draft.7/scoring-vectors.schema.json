                "id": {
                  "const": "dora"
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "uradora"
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "akadora"
                }
              }
            },
            "minContains": 2
          }
        }
      ]
