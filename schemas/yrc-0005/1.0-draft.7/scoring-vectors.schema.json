            "daiminkan": {
              "type": "string",
              "enum": [
                "before_rinshan",
                "after_rinshan_discard"
              ]
            },
            "kakan": {
              "type": "string",
              "enum": [
                "before_rinshan",
                "after_rinshan_discard"
              ]
