                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 0
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 1
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 2
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 3
                }
              }
            },
            "minContains": 2
          }
        }
      ]
    },
    "unique_win_actors": {
      "allOf": [
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 0
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 1
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 2
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "actor"
              ],
              "properties": {
                "actor": {
                  "const": 3
                }
              }
            },
            "minContains": 2
          }
        }
      ]
