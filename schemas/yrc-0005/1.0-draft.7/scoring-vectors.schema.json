    "tile": {
      "type": "string",
      "enum": [
        "1m",
        "2m",
        "3m",
        "4m",
        "5m",
        "5mr",
        "6m",
        "7m",
        "8m",
        "9m",
        "1p",
        "2p",
        "3p",
        "4p",
        "5p",
        "5pr",
        "6p",
        "7p",
        "8p",
        "9p",
        "1s",
        "2s",
        "3s",
        "4s",
        "5s",
        "5sr",
        "6s",
        "7s",
        "8s",
        "9s",
        "E",
        "S",
        "W",
        "N",
        "P",
        "F",
        "C"
      ]
    },
    "score_array": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "multipleOf": 100
      }
    },
    "unique_other_winner_actors": {
