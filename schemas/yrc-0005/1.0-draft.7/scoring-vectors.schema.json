{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yamai:schema:yrc-0005:1.0-draft.7:scoring-vectors",
  "title": "YAMAI riichi-4p executable scoring fixtures",
  "type": "object",
  "required": [
    "$schema",
    "protocol_version",
    "profile_revision",
    "rules",
    "vectors",
    "fixtures",
    "negative_fixtures"
  ],
  "properties": {
    "$schema": {
      "const": "urn:yamai:schema:yrc-0005:1.0-draft.7:scoring-vectors"
    },
    "protocol_version": {
      "const": "1.0-draft.9"
    },
    "profile_revision": {
      "const": "1.0-draft.7"
    },
    "rules": {
