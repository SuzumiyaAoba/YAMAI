      "type": "object",
      "required": [
        "bakaze",
        "kyoku",
        "oya",
        "honba",
        "kyotaku",
        "wall_remaining",
        "rinshan",
        "reach_accepted",
        "pending_kan",
        "double_riichi",
        "ippatsu",
        "first_turn",
        "last_tile",
        "furiten",
        "kan_counts",
        "scores",
        "pre_state",
        "events"
      ],
      "properties": {
        "bakaze": {
          "enum": [
            "E",
            "S",
            "W",
            "N"
          ]
        },
        "kyoku": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "oya": {
          "$ref": "#/$defs/seat"
        },
        "honba": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kyotaku": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wall_remaining": {
