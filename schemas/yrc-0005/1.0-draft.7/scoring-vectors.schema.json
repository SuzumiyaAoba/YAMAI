    "meld": {
      "type": "object",
      "required": [
        "kind",
        "tiles",
        "open"
      ],
      "properties": {
        "kind": {
          "enum": [
            "chi",
            "pon",
            "daiminkan",
            "ankan",
            "kakan"
          ]
        },
        "tiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/tile"
          }
        },
        "open": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/seat"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "chi",
                  "pon",
                  "daiminkan",
                  "kakan"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "open": {
                "const": true
              }
            },
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ankan"
              }
            }
          },
          "then": {
            "properties": {
              "open": {
                "const": false
              }
            },
            "not": {
              "required": [
                "source"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "chi"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "tiles": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "pon"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "tiles": {
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "daiminkan",
                  "ankan",
                  "kakan"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "tiles": {
                "minItems": 4,
                "maxItems": 4
              }
            }
          }
        }
      ]
    },
    "hand": {
      "type": "object",
      "required": [
        "concealed_tiles",
        "melds"
      ],
      "properties": {
        "concealed_tiles": {
          "type": "array",
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/tile"
          }
        },
        "melds": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/meld"
          }
        }
      },
      "additionalProperties": false
    },
    "state_event": {
      "type": "object",
      "required": [
        "type",
        "actor"
      ],
      "properties": {
        "type": {
          "enum": [
            "tsumo",
            "dahai",
            "reach",
            "reach_accepted",
            "chi",
            "pon",
            "daiminkan",
            "ankan_declared",
            "ankan",
            "kakan_declared",
            "kakan"
