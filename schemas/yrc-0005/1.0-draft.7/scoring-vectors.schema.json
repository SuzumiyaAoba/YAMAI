        "ippatsu": {
          "type": "boolean"
        },
        "first_turn": {
          "type": "boolean"
        },
        "last_tile": {
          "type": "boolean"
        },
        "furiten": {
          "type": "boolean"
        },
        "kan_counts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "scores": {
          "$ref": "#/$defs/score_array"
        },
        "pre_state": {
          "$ref": "#/$defs/state_core"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_event"
          }
        }
