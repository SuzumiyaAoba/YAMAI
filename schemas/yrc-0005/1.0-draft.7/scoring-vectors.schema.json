                "yaku_id"
              ],
              "properties": {
                "yaku_id": {
                  "const": "daisangen"
                }
              }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": [
                "yaku_id"
              ],
              "properties": {
                "yaku_id": {
                  "const": "daisuushii"
                }
              }
            },
            "minContains": 2
          }
        }
      ]
