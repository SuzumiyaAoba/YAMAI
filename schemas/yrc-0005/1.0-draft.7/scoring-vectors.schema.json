      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "tsumo",
                  "dahai",
                  "ankan_declared",
                  "kakan_declared"
                ]
              }
            }
          },
          "then": {
            "required": [
              "pai"
            ]
          }
        }
      ]
